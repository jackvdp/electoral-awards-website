# Copy only needed servers to .codex/config.toml. See agent-support/mcp.md.

[mcp_servers.exa]
url = "https://mcp.exa.ai/mcp"

[mcp_servers.hunter]
url = "https://mcp.hunter.io/mcp"
env_http_headers = { "X-API-KEY" = "HUNTER_API_KEY" }

[mcp_servers.firecrawl]
command = "npx"
args = ["-y", "firecrawl-mcp"]
env_vars = ["FIRECRAWL_API_KEY"]

[mcp_servers.mongodb]
command = "npx"
args = ["-y", "mongodb-mcp-server@latest"]
env_vars = ["MDB_MCP_CONNECTION_STRING"]

[mcp_servers.neon]
url = "https://mcp.neon.tech/mcp"

[mcp_servers.Canva]
url = "https://mcp.canva.com/mcp"

[mcp_servers.cloudflare-dns-analytics]
url = "https://dns-analytics.mcp.cloudflare.com/mcp"
